{
  "name": "Order",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "merchandiseId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "shippingAddress": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAID",
        "SHIPPED",
        "DELIVERED",
        "CANCELLED"
      ],
      "default": "PENDING"
    },
    "trackingNumber": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}