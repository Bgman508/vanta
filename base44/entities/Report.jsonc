{
  "name": "Report",
  "type": "object",
  "properties": {
    "reportedBy": {
      "type": "string",
      "description": "User who reported"
    },
    "entityType": {
      "type": "string",
      "enum": [
        "EXPERIENCE",
        "USER",
        "COMMENT"
      ],
      "description": "Type of content reported"
    },
    "entityId": {
      "type": "string",
      "description": "ID of reported content"
    },
    "reason": {
      "type": "string",
      "enum": [
        "INAPPROPRIATE",
        "COPYRIGHT",
        "SPAM",
        "HARASSMENT",
        "OTHER"
      ],
      "description": "Report reason"
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "REVIEWING",
        "RESOLVED",
        "DISMISSED"
      ],
      "default": "PENDING",
      "description": "Report status"
    },
    "reviewedBy": {
      "type": "string",
      "description": "Admin who reviewed"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Review timestamp"
    },
    "resolution": {
      "type": "string",
      "description": "Resolution notes"
    }
  },
  "required": [
    "reportedBy",
    "entityType",
    "entityId",
    "reason"
  ],
  "rls": {
    "create": {
      "reportedBy": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "reportedBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}