{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Owner"
    },
    "name": {
      "type": "string",
      "description": "Playlist name"
    },
    "description": {
      "type": "string"
    },
    "experienceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverUrl": {
      "type": "string"
    },
    "public": {
      "type": "boolean",
      "default": false
    },
    "collaborative": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "userId",
    "name"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "public": true
        }
      ]
    },
    "update": {
      "userId": "{{user.id}}"
    },
    "delete": {
      "userId": "{{user.id}}"
    }
  }
}