{
  "name": "PromoCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Promo code (uppercase)"
    },
    "createdBy": {
      "type": "string",
      "description": "Artist/label who created"
    },
    "experienceId": {
      "type": "string",
      "description": "Specific experience (null for all)"
    },
    "discountType": {
      "type": "string",
      "enum": [
        "PERCENTAGE",
        "FIXED",
        "FREE"
      ],
      "description": "Type of discount"
    },
    "discountValue": {
      "type": "number",
      "description": "Percentage (0-100) or cents"
    },
    "maxUses": {
      "type": "number",
      "description": "Maximum redemptions"
    },
    "usedCount": {
      "type": "number",
      "default": 0,
      "description": "Times redeemed"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration date"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Is active"
    }
  },
  "required": [
    "code",
    "createdBy",
    "discountType"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "createdBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "createdBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "createdBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "createdBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}