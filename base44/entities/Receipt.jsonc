{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User who made payment"
    },
    "experienceId": {
      "type": "string",
      "description": "Experience purchased"
    },
    "amountCents": {
      "type": "number",
      "description": "Amount paid in cents"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code"
    },
    "paymentProvider": {
      "type": "string",
      "enum": [
        "STRIPE",
        "MANUAL",
        "INTERNAL"
      ],
      "description": "Payment provider"
    },
    "externalId": {
      "type": "string",
      "description": "External payment ID (Stripe charge ID)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "FAILED",
        "REFUNDED"
      ],
      "default": "COMPLETED",
      "description": "Payment status"
    },
    "refundedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Refund timestamp"
    },
    "refundReason": {
      "type": "string",
      "description": "Reason for refund"
    },
    "metadata": {
      "type": "object",
      "description": "Payment metadata"
    }
  },
  "required": [
    "userId",
    "experienceId",
    "amountCents",
    "paymentProvider"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}