{
  "name": "ExperienceApproval",
  "type": "object",
  "properties": {
    "experienceId": {
      "type": "string",
      "description": "Experience requiring approval"
    },
    "submittedBy": {
      "type": "string",
      "description": "Artist/creator user ID"
    },
    "orgId": {
      "type": "string",
      "description": "Organization reviewing (label/publisher)"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "CHANGES_REQUESTED"
      ],
      "default": "SUBMITTED",
      "description": "Approval status"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Submission timestamp"
    },
    "reviewedBy": {
      "type": "string",
      "description": "User ID who reviewed"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Review timestamp"
    },
    "reviewNotes": {
      "type": "string",
      "description": "Feedback from reviewer"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Submission version"
    },
    "changesRequested": {
      "type": "array",
      "description": "List of required changes",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "experienceId",
    "submittedBy"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "submittedBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "submittedBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "LABEL"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "LABEL"
          }
        }
      ]
    }
  }
}