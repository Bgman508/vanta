{
  "name": "PreOrder",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User who pre-ordered"
    },
    "experienceId": {
      "type": "string",
      "description": "Experience pre-ordered"
    },
    "amountPaid": {
      "type": "number",
      "description": "Amount in cents"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "FULFILLED",
        "REFUNDED"
      ],
      "default": "PENDING",
      "description": "Pre-order status"
    },
    "receiptId": {
      "type": "string",
      "description": "Payment receipt"
    },
    "fulfilledAt": {
      "type": "string",
      "format": "date-time",
      "description": "When access granted"
    }
  },
  "required": [
    "userId",
    "experienceId",
    "amountPaid"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}