{
  "name": "Session",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "User ID"
    },
    "device": {
      "type": "string",
      "description": "Device info"
    },
    "browser": {
      "type": "string",
      "description": "Browser info"
    },
    "ipAddress": {
      "type": "string",
      "description": "IP address"
    },
    "location": {
      "type": "string",
      "description": "Approximate location"
    },
    "lastActive": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity timestamp"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}