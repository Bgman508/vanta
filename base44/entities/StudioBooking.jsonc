{
  "name": "StudioBooking",
  "type": "object",
  "properties": {
    "studioId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "startTime": {
      "type": "string",
      "format": "date-time"
    },
    "endTime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "CANCELLED",
        "COMPLETED"
      ],
      "default": "PENDING"
    },
    "price": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "studioId",
    "userId",
    "startTime",
    "endTime"
  ],
  "rls": {
    "create": {
      "userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "userId": "{{user.id}}"
    }
  }
}