{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrerId": {
      "type": "string",
      "description": "User who referred"
    },
    "referredEmail": {
      "type": "string",
      "description": "Email of referred user"
    },
    "referredUserId": {
      "type": "string",
      "description": "User ID once registered"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "COMPLETED",
        "EXPIRED"
      ],
      "default": "PENDING"
    },
    "rewardGranted": {
      "type": "boolean",
      "default": false
    },
    "code": {
      "type": "string",
      "description": "Referral code"
    }
  },
  "required": [
    "referrerId",
    "referredEmail",
    "code"
  ],
  "rls": {
    "create": {
      "referrerId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "referrerId": "{{user.id}}"
        },
        {
          "referredUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}