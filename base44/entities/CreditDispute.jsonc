{
  "name": "CreditDispute",
  "type": "object",
  "properties": {
    "experienceId": {
      "type": "string",
      "description": "Experience being disputed"
    },
    "disputedBy": {
      "type": "string",
      "description": "User ID filing dispute"
    },
    "disputeType": {
      "type": "string",
      "enum": [
        "MISSING_CREDIT",
        "INCORRECT_ROLE",
        "SPLIT_DISPUTE",
        "REMOVAL_REQUEST"
      ],
      "description": "Type of dispute"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "UNDER_REVIEW",
        "RESOLVED",
        "REJECTED",
        "ESCALATED"
      ],
      "default": "PENDING",
      "description": "Dispute status"
    },
    "description": {
      "type": "string",
      "description": "Dispute details"
    },
    "requestedChange": {
      "type": "object",
      "description": "Proposed changes"
    },
    "resolution": {
      "type": "string",
      "description": "Resolution notes"
    },
    "resolvedBy": {
      "type": "string",
      "description": "User ID who resolved"
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Resolution timestamp"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Credit version number"
    }
  },
  "required": [
    "experienceId",
    "disputedBy",
    "disputeType",
    "description"
  ],
  "rls": {
    "create": {
      "disputedBy": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "disputedBy": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "disputedBy": "{{user.id}}",
          "status": {
            "$in": [
              "PENDING",
              "UNDER_REVIEW"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "disputedBy": "{{user.id}}",
          "status": "PENDING"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}